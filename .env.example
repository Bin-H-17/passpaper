# PassPaper environment variables (all optional).
#
# Note: PassPaper reads these directly from the environment (os.environ).
# This file documents them — copy to .env only if your launcher sources it
# (PassPaper itself does NOT auto-load .env files).

# --- Recognition (optional local VLM) ---------------------------------------
# A local OpenAI-compatible /v1 endpoint. When unset, PassPaper does NOT call
# any recognition service and lets the AI agent read the image directly.
# Examples: ollama  http://127.0.0.1:11434/v1
#           llama.cpp  http://127.0.0.1:8080/v1
#           vLLM / LM Studio  http://127.0.0.1:8000/v1
# PASSPAPER_RECOGNIZER_ENDPOINT=http://127.0.0.1:11434/v1

# Model name for the endpoint above (e.g. qwen2.5-vl:7b).
# PASSPAPER_RECOGNIZER_MODEL=qwen2.5-vl:7b

# Bearer key if your endpoint requires auth (leave empty for local ollama).
# PASSPAPER_RECOGNIZER_KEY=

# --- Daemon / data dir ------------------------------------------------------
# Override the data directory (default: ~/.passpaper). Useful for tests or
# portable installs.
# PASSPAPER_HOME=/tmp/passpaper-test

# Set to any non-empty value to also stream daemon logs to stderr (foreground
# debugging via `passpaper serve`).
# PASSPAPER_FG=1
